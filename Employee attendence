import pandas as pd
class AttendanceAnalyzer:
    def create_attendance_df(self, data: list) -> pd.DataFrame:
        columns = [
            "EmployeeID",
            "Department",
            "Date",
            "Attendance"
        ]
        df = pd.DataFrame(data, columns=columns)
        return df

    def compute_monthly_attendance_rate(
        self,
        df: pd.DataFrame
    ) -> pd.DataFrame:

        attendance_df = df.copy()
        # Extract Year-Month
        attendance_df["Month"] = (
            attendance_df["Date"]
            .str[:7]
        )
        # Total days per employee/month
        total_days = (
            attendance_df
            .groupby(
                ["EmployeeID", "Month"]
            )
            .size()
            .reset_index(name="TotalDays")
        )
        # Present days only
        present_days = (
            attendance_df[
                attendance_df["Attendance"] == "Present"
            ]
            .groupby(
                ["EmployeeID", "Month"]
            )
            .size()
            .reset_index(name="PresentDays")
        )
        # Merge total and present counts
        result = pd.merge(
            total_days,
            present_days,
            on=["EmployeeID", "Month"],
            how="left"
        )
        # Replace NaN with 0
        result["PresentDays"] = (
            result["PresentDays"]
            .fillna(0)
            .astype(int)
        )
        # Calculate attendance percentage
        result["Attendance Rate"] = (
            result["PresentDays"]
            / result["TotalDays"]
            * 100
        ).round(2)

        return result[
            [
                "EmployeeID",
                "Month",
                "Attendance Rate"
            ]
        ]

    def add_absence_flag(
        self,
        df: pd.DataFrame
    ) -> pd.DataFrame:
        result = df.copy()

        result["IsAbsent"] = (
            result["Attendance"] == "Absent"
        ).astype(int)

        return result

    def high_absentees(
        self,
        df: pd.DataFrame,
        threshold: int
    ) -> pd.DataFrame:

        absence_df = df[
            df["Attendance"] == "Absent"
        ]

        result = (
            absence_df
            .groupby("EmployeeID")
            .size()
            .reset_index(name="Absence Count")
        )

        result = result[
            result["Absence Count"] > threshold
        ]
        return result.reset_index(drop=True)

    def department_attendance_summary(
        self,
        df: pd.DataFrame
    ) -> pd.DataFrame:

        summary = pd.crosstab(
            df["Department"],
            df["Attendance"]
        )

        # Remove column header name
        summary.columns.name = None

        # Ensure all attendance categories exist
        summary = summary.reindex(
            columns=[
                "Present",
                "Absent",
                "Leave"
            ],
            fill_value=0
        )
        return summary.reset_index()


